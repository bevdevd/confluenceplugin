{namespace Confluence.Templates.Mail.Content}
/**
 * Actions Pattern, expects a sequence of com.atlassian.confluence.api.model.web.WebItemView objects
 * @param actions Iterable<com.atlassian.confluence.api.model.web.WebItemView>
 */
{template .actionsPattern}
<table id="actions-pattern" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td id="actions-pattern-container" valign="middle">
            /* Loop for secondary actions as necessary */
            {if $actions}
                {foreach $action in $actions}
                    {if $action}
                    <table {if not isLast($action)}align="left"{/if}>
                        <tr>
                            {let $link: webItemLink($action) /}
                            {if $action.icon}
                            <td class="actions-pattern-action-icon-container">
                                /* secondary action icon */
                                <a href="{$link}" title="{$action.label} Icon">
                                    <img class="actions-pattern-action-icon-image" height="16" width="16" border="0"
                                         title="{$action.label} Icon"
                                         src="{$action.icon.path}"
                                         alt="{$action.label} Icon" />
                                </a>
                            </td>
                            {/if}
                            <td class="actions-pattern-action-text-container">
                                /* secondary action text */
                                <a href="{$link}" title="{$action.label}">{$action.label}</a>
                            </td>
                            {if not isLast($action)}
                            <td class="actions-pattern-action-bull">
                                &bull;
                            </td>
                            {/if}
                        </tr>
                    </table>
                    {/if}
                {/foreach}
            {/if}
        </td>
    </tr>
</table>
{/template}