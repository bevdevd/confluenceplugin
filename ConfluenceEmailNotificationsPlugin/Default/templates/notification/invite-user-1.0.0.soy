{namespace Confluence.Templates.Mail.Notifications}
/**
 * Template for invite users email
 * @param modifier
 * @param avatarCid
 * @param messageHtml
 * @param signupURL
 * @param siteTitle
 */
{template .inviteUser}
    {let $inviteMessage}
        {call Confluence.Templates.Mail.Content.notificationCommentPattern}
            {param comment}
                {call Confluence.Templates.Mail.Content.inlineContentStyles}
                    {param content: $messageHtml/}
                {/call}
            {/param}
        {/call}
    {/let}
    {let $actionButton}
        {call Confluence.Templates.Mail.Content.primaryButton}
            {param buttonLink}
                {baseUrl()}{$signupURL|noAutoescape}
            {/param}
            {param buttonText: getText('email.user.call.to.action')/}
        {/call}
    {/let}
    {call Confluence.Templates.Mail.Chrome.mainTable}
        {param header}
            {call Confluence.Templates.Mail.Chrome.headerPattern}
                {param actionString: getText('confluence.mail.templates.invite.user', $siteTitle)/}
                {param avatarImage: $avatarCid/}
                {param user: $modifier/}
            {/call}
        {/param}
        {param contentArea: [$inviteMessage, $actionButton]/}
        {param footer}
            {call Confluence.Templates.Mail.Chrome.footerPattern/}
        {/param}
    {/call}
{/template}